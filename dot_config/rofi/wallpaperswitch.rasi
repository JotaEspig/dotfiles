configuration {
    font: "JetBrains Mono 12";
    show-icons: true;
    case-sensitive: false;
}

@theme "rounded-blue-dark"

window {
    width:            1200px;
    height:           500px; 
    border-radius:    15px;
    border:           2px;
    border-color:     #ffffff30;
    padding:          0px;
    background-color: @bg0;
}

mainbox {
    background-color: transparent;
    border:           0px;
    spacing:          0px;
    padding:          0px;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    border:           1px;
    margin:           15px;
    padding:          10px;
    border-radius:    10px;
    children:         [ "textbox-prompt-colon", "entry" ];
}

listview {
    columns:          3;
    lines:            1;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          0px;
    padding:          0px;
    margin:           0px;
    background-color: transparent;
    fixed-height:     true;
}

element {
    orientation:      vertical;
    padding:          10px 0px;
    spacing:          10px 0px;
    background-color: @bg2;
    text-color:       @fg0;
    margin:           10px;
    border-radius:    10px;
}

element selected {
    background-color: @bg3;
    text-color:       @fg1;
    border-radius:    10px;
}

element-icon {
    size:             350px;
    horizontal-align: 0.5;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    enabled: false;
}

textbox-prompt-colon {
    expand:           false;
    str:              "   ";
    text-color:       inherit;
    background-color: transparent;
}

entry {
    background-color: transparent;
    text-color:       inherit;
    placeholder:      "Search Wallpapers...";
}
